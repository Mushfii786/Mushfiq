{
  "entities": {
    "Message": {
      "title": "Contact Message",
      "description": "Incoming inquiries and messages sent via portfolio contact form",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender full name",
          "maxLength": 100,
          "minLength": 1
        },
        "email": {
          "type": "string",
          "description": "Sender email address",
          "maxLength": 150,
          "pattern": "^[^@]+@[^@]+\\.[^@]+$"
        },
        "phone": {
          "type": "string",
          "description": "Sender phone number",
          "maxLength": 30
        },
        "location": {
          "type": "string",
          "description": "Sender country or city location",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Message content",
          "maxLength": 3000,
          "minLength": 2
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "read": {
          "type": "boolean",
          "description": "Whether message has been reviewed by admin"
        }
      },
      "required": ["name", "email", "message"]
    },
    "Video": {
      "title": "Portfolio Reel Video",
      "description": "Cinematic and custom showcase video entries in portfolio gallery",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique video identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Video project title",
          "maxLength": 150,
          "minLength": 1
        },
        "category": {
          "type": "string",
          "description": "Genre category tag",
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "description": "Thumbnail or poster image URL",
          "maxLength": 2048
        },
        "videoUrl": {
          "type": "string",
          "description": "Video stream source or Google Drive URL",
          "maxLength": 2048
        },
        "caption": {
          "type": "string",
          "description": "Short project description",
          "maxLength": 1000
        },
        "location": {
          "type": "string",
          "description": "Filming location",
          "maxLength": 100
        },
        "camera": {
          "type": "string",
          "description": "Camera gear used",
          "maxLength": 100
        },
        "lens": {
          "type": "string",
          "description": "Lens gear used",
          "maxLength": 100
        },
        "settings": {
          "type": "string",
          "description": "Frame rate & resolution notes",
          "maxLength": 100
        },
        "year": {
          "type": "string",
          "description": "Release year / tag",
          "maxLength": 40
        },
        "column": {
          "type": "number",
          "description": "Grid column index (1-4)"
        },
        "aspectRatioClass": {
          "type": "string",
          "description": "CSS aspect ratio class",
          "maxLength": 50
        },
        "duration": {
          "type": "string",
          "description": "Runtime duration string",
          "maxLength": 20
        },
        "views": {
          "type": "number",
          "description": "Total play count"
        },
        "likes": {
          "type": "number",
          "description": "Community appreciation count"
        },
        "isCustom": {
          "type": "boolean",
          "description": "Custom user uploaded or Drive added video"
        }
      },
      "required": ["id", "title", "url", "videoUrl"]
    },
    "AdminProfile": {
      "title": "Admin Profile",
      "description": "Admin configuration and privileged access metadata",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Authorization level",
          "enum": ["admin", "owner"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": {
        "$ref": "Message"
      },
      "description": "Inquiries submitted through the portfolio contact form"
    },
    "/videos/{videoId}": {
      "schema": {
        "$ref": "Video"
      },
      "description": "Video gallery entries managed by portfolio owner"
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "AdminProfile"
      },
      "description": "Trusted admin identities and access verification"
    }
  }
}
